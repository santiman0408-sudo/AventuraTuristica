<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet y ubicación para Google Maps -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AventuraTuristica">

        <!-- Clave de Google Maps -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Pantalla de bienvenida: entrada principal -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Inicio de sesión -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Registro de reservas -->
        <activity
            android:name=".activities.CrearReservaActivity"
            android:exported="false" />

        <!-- Listado de reservas -->
        <activity
            android:name=".activities.ReservasActivity"
            android:exported="false" />

        <!-- Detalle de la reserva -->
        <activity
            android:name=".activities.DetalleReservaActivity"
            android:exported="false" />

        <!-- Mapa y punto de encuentro -->
        <activity
            android:name=".activities.MapActivity"
            android:exported="false" />

        <!-- Pantalla de inicio existente: Home -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>




