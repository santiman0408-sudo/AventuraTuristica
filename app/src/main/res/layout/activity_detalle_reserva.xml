<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle de reserva"
            android:textColor="#17324D"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Nombre del cliente -->
        <TextView
            android:id="@+id/tvDetalleCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del cliente"
            android:textColor="#17324D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Identificador de la reserva -->
        <TextView
            android:id="@+id/tvDetalleId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Código de reserva"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- Teléfono -->
        <TextView
            android:id="@+id/tvDetalleTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teléfono"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Destino turístico -->
        <TextView
            android:id="@+id/tvDetalleDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destino turístico"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Fecha del viaje -->
        <TextView
            android:id="@+id/tvDetalleFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha del viaje"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Cantidad de personas -->
        <TextView
            android:id="@+id/tvDetallePersonas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cantidad de personas"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Estado actual de la reserva -->
        <TextView
            android:id="@+id/tvDetalleEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: PENDIENTE"
            android:textColor="#8A5100"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Punto de encuentro -->
        <TextView
            android:id="@+id/tvDetallePunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Punto de encuentro"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Coordenadas geográficas -->
        <TextView
            android:id="@+id/tvDetalleCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latitud y longitud"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Abrir Google Maps -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginBottom="12dp"
            android:text="Ver punto de encuentro en Google Maps"
            android:textAllCaps="false" />

        <!-- Actualizar estado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizarEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Actualizar estado"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>

