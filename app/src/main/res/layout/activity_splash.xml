<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦"
        android:textColor="#6B4EFF"
        android:textSize="64sp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Logotipo de AventuraTurística" />

    <TextView
        android:id="@+id/tvSplashTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AventuraTurística"
        android:textColor="#17324D"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descubre nuevos destinos y vive experiencias extraordinarias."
        android:textColor="#616B75"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="28dp" />

    <ProgressBar
        android:id="@+id/progressSplash"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:indeterminateTint="#6B4EFF"
        android:contentDescription="Cargando aplicación" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparando tu próxima aventura..."
        android:textColor="#616B75"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
